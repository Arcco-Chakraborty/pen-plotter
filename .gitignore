# Third-party toolchain - 482 MB of arduino-cli, its package cache, and the
# GRBL-Plotter binary distribution. Not ours, and re-downloadable. build.ps1
# expects these at tools\arduino-cli and tools\acli-data / tools\acli-user.
tools/

# Python venv for vpype (a4prep.ps1). Recreate with:
#   python -m venv .venv
#   .venv\Scripts\python -m pip install vpype
.venv/

# Generated by a4prep.ps1 from the source SVGs - derived, not source.
*_a4.svg

# The original upstream clone's git dir, renamed so its contents could be
# vendored into this repo as regular files. Kept locally so the fra589 remote
# and history are recoverable; safe to delete if you don't want it.
firmware/.git.disabled/

# Arduino / avr build output
*.hex
*.elf
*.o
firmware/build/

# Written by plot.ps1 at runtime. Both describe THIS machine and THIS sheet -
# the paper frame is only meaningful until the board is reset, so committing it
# would hand the next person a calibration that is already wrong.
plotter-config.json
paper-frame.json

# Python bytecode
__pycache__/
*.pyc

# Editor / OS noise
.vscode/
Thumbs.db
desktop.ini
